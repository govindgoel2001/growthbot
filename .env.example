# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required for script generation.

# Required for topic_engine.py script generation (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Optional: raises GitHub search rate limit (github.com -> Settings -> Developer settings -> PAT, read-only)
GITHUB_TOKEN=

# Optional override; defaults to https://www.myhermes.cloud
MYHERMES_BASE_URL=https://www.myhermes.cloud

# Optional: override the model used by topic_engine.py (defaults to claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6
